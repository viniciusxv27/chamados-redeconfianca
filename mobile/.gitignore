# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# endereço da API da máquina de cada um
.env

# pastas nativas geradas pelo prebuild (CNG)
/ios
/android

# Chave de upload do Android (Play Console) — nunca versionar; guardar cópia em local seguro
credentials/
credentials.json

# Chave da conta de serviço do Firebase (FCM v1) — vai só para o EAS (eas credentials), nunca para o git.
# (O google-services.json pode ser versionado: o build do EAS precisa dele.)
*firebase-adminsdk*.json
fcm-*.json
